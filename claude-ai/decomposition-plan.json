        "Cheek_Blush_L/R, Nose_Shadow, Chin",
        "Eye_L/R_White, Iris_Orange, Pupil, Highlights_Large/Small",
        "UpperLid_L/R, LowerLid_L/R, Lashes_L/R, Eyeliner_L/R",
        "Brow_L/R_Neutral/Smile/Surprise/Serious",
        "Mouth_A/I/U/E/O, Smile, Open_Smile, Frown, Teeth, Tongue",
        "Glasses_Frame_L/R, Bridge, Lens_L/R, Lens_Reflection, Temple_L/R"
