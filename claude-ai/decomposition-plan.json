{
  "character": "Claude AI 拟人角色拆解",
  "goal": "基于提供的 Claude AI 全身立绘，输出高规格 Live2D PSD/Cubism 生产拆分工单，供画师重绘分层与建模师绑定。",
  "warning": "本方案仍基于压平参考图的手动标注。像素级分层与遮挡补画需要高清原图或重绘稿。",
  "referenceDimensions": { "width": 850, "height": 1106, "unit": "px", "note": "坐标与现有 Aurelia 项目保持一致的画布比例，供第一轮切割参考。" },
